{
  "name": "touching-some-grass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "dev:all": "concurrently -k -n web,signal -c cyan,magenta \"npm:dev\" \"npm:signaling\"",
    "start": "node --env-file-if-exists=.env dist/signaling/server.js",
    "signaling": "tsx watch signaling/server.ts",
    "signaling:build": "tsc -p signaling/tsconfig.json",
    "signaling:start": "node --env-file-if-exists=.env dist/signaling/server.js",
    "build": "tsc -b && vite build --configLoader runner && npm run signaling:build",
    "preview": "vite preview --configLoader runner --host 0.0.0.0",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:integration": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --esModuleInterop --types node playwright.config.ts e2e/p2p.spec.ts signaling/server.test.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-collaboration-caret": "^3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/y-tiptap": "^3.0.9",
    "@vitejs/plugin-react": "5.0.4",
    "idb": "8.0.4",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.5",
    "tailwindcss": "3.4.17",
    "ws": "^8.22.1",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "13.6.33",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/ws": "^8.5.13",
    "autoprefixer": "10.4.21",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "6.2.7",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
