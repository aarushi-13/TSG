# The production Node service listens on this port (the platform may provide PORT itself).
PORT=4444

# Development frontend connection settings; public values only, no credentials belong in VITE_*.
# The signaling URL defaults to the current page's host and protocol in production.
# Set this when Vite runs separately from `npm run signaling` on port 4444.
# VITE_SIGNALING_URL=ws://localhost:4444
# Optional JSON array overriding the default public Google STUN server.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.net:3478"}]
# Optional summary endpoint override for local development; production uses same-origin by default.
# VITE_SUMMARY_URL=http://localhost:4455/api/summarize

# Server-only Groq settings. GROQ_API_KEY is never exposed to the frontend.
# Without a key, POST /api/summarize responds 503 with a not-configured message.
# GROQ_API_KEY=your-key-here
# Optional model override; defaults to openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional exact browser origins allowed to connect to signaling WebSockets.
# Same-origin deployments normally do not need this setting.
# WS_ALLOWED_ORIGINS=https://your-app.example,https://www.your-app.example
