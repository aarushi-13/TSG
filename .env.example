# Public connection settings. No credentials belong in VITE_* variables.
# Default signaling URL is ws[s]://<current browser hostname>:4444.
# VITE_SIGNALING_URL=ws://192.168.1.20:4444
# Optional STUN override, comma-separated; defaults to Google's public STUN endpoint.
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# Signaling service settings (server process only; not read by the frontend).
# PORT=4444
# Restrict the service to trusted frontend origins in deployment.
# WS_ALLOWED_ORIGINS=https://your-app.example,https://www.your-app.example

# Groq API key for the AI summarizer (server process only; never exposed to the frontend).
# Without it, POST /api/summarize replies 503 and the editor shows a "not configured" message.
# GROQ_API_KEY=your-key-here
# Optional: override the Groq model used for summaries (defaults to openai/gpt-oss-20b).
# GROQ_MODEL=openai/gpt-oss-20b
